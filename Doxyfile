GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_TIMESTAMP         = NO

# ==============================================================================
# DOXYGEN AWESOME CSS & JAVASCRIPT EXTENSIONS
# ==============================================================================
HTML_EXTRA_STYLESHEET  = docs/theme/doxygen-awesome/doxygen-awesome.css

HTML_EXTRA_FILES       = docs/theme/doxygen-awesome/doxygen-awesome-darkmode-toggle.js \
                         docs/theme/doxygen-awesome/doxygen-awesome-fragment-copy-button.js \
                         docs/theme/doxygen-awesome/doxygen-awesome-paragraph-link.js \
                         docs/theme/doxygen-awesome/doxygen-awesome-interactive-toc.js \
