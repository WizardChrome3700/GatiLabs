PROJECT_NAME           = "Multi Vehicle Simulator"
PROJECT_BRIEF          = "High-fidelity C++ multivehicle simulator for hobbyists and researcher"

# ==============================================================================
# INPUT & OUTPUT SETTINGS
# ==============================================================================
OUTPUT_DIRECTORY       = docs/
INPUT                  = include/ src/
RECURSIVE              = YES
EXCLUDE                = assets/ configs/ build/ .vscode/ docs/theme/doxygen-awesome .idea/ .git/ CMakeFiles/ CMakeCache.txt
EXTRACT_ALL            = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

